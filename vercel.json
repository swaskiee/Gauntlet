{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gauntlet-telemetry.onrender.com/api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "/web/static/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/web/static/index.html"
    }
  ]
}
